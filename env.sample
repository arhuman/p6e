# Copy to .env and adjust. Compose auto-loads ./.env for ${VAR} interpolation.
# .env is not committed; in production keep it beside the compose files at 0600.

# ---- image ----
# Version metadata stamped into the binary, so `p6e version` and the image agree.
# Match the Makefile: git describe / rev-parse / committer date.
P6E_VERSION=dev
P6E_COMMIT=unknown
P6E_BUILD_DATE=unknown
# Explicit tag, never latest.
P6E_TAG=0.1.0

# ---- what to serve ----
# The directory of pipelines, mounted read-only at /pipelines. Every file in it
# that compiles and declares a trigger is served; the rest are reported and
# skipped. `make preflight` compiles the whole directory before prod starts, so
# a collision or a typo stops the deploy rather than the daemon.
#
# ./examples is fine for `make local` and is refused for prod: it ships
# broken.yaml on purpose, as the worked example of a rejection.
P6E_PIPELINES=./examples

# ---- runtime ----
TZ=UTC
# Steps in flight across every pipeline at once, not pipelines. This is the
# process-wide goroutine bound.
P6E_MAX_CONCURRENCY=256

# ---- local ports ----
P6E_PORT=8080
# Health, readiness and metrics. Published to loopback only in every overlay.
P6E_ADMIN_PORT=8081

# ---- production only ----
# Routed by the host's shared Traefik. `make up` should refuse to start on the
# placeholder rather than serving a stranger's domain.
APEX_DOMAIN=example.invalid
TRAEFIK_CERTRESOLVER=letsencrypt

# Edge authentication for the webhook routers. A webhook pipeline with no `auth`
# block in its trigger runs for anyone who can reach the router, and the exec
# node runs local processes, so an open route is worth taking seriously.
#
# Generate with:  htpasswd -nbB <user> <password>
# Then double every $ in the hash, because compose interpolates ${...} here:
#   $2y$05$...  becomes  $$2y$$05$$...
#
# This is belt and braces with the trigger's own signature check, not a
# replacement for it. See SECURITY.md and ADR 0013.
P6E_BASIC_AUTH=changeme:$$2y$$05$$replace.this.with.a.real.htpasswd.hash
P6E_CPU_LIMIT=2.0
P6E_MEMORY_LIMIT=512M
