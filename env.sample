# Copy to .env and adjust. Compose auto-loads ./.env for ${VAR} interpolation.
# .env is not committed; in production keep it beside the compose files at 0600.

# ---- image ----
# Version metadata stamped into the binary, so `p6e version` and the image agree.
# Match the Makefile: git describe / rev-parse / committer date.
P6E_VERSION=dev
P6E_COMMIT=unknown
P6E_BUILD_DATE=unknown
# Explicit tag, never latest.
P6E_TAG=0.1.0

# ---- what to serve ----
# The directory of pipelines, mounted read-only at /pipelines. Every file in it
# that compiles and declares a trigger is served; the rest are reported and
# skipped. Validate it before deploying with: p6e check --dir <dir>
P6E_PIPELINES=./examples

# ---- runtime ----
TZ=UTC
# Steps in flight across every pipeline at once, not pipelines. This is the
# process-wide goroutine bound.
P6E_MAX_CONCURRENCY=256

# ---- local ports ----
P6E_PORT=8080
# Health, readiness and metrics. Published to loopback only in every overlay.
P6E_ADMIN_PORT=8081

# ---- production only ----
# Routed by the host's shared Traefik. `make up` should refuse to start on the
# placeholder rather than serving a stranger's domain.
APEX_DOMAIN=example.invalid
TRAEFIK_CERTRESOLVER=letsencrypt
P6E_CPU_LIMIT=2.0
P6E_MEMORY_LIMIT=512M
